{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Read(**/.secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/wireguard/**)",
      "Read(**/wg*.conf)",
      "Read(**/openvpn/**)",
      "Read(**/*.ovpn)",
      "Read(**/vnc/**)",
      "Bash(sudo:*)",
      "Bash(ssh:*)",
      "Bash(kubectl:*)",
      "Bash(rm -rf /:*)",
      "Bash(* .env*)",
      "Bash(*/.env*)",
      "Bash(*.secrets/*)",
      "Bash(*.pem*)",
      "Bash(*id_rsa*)",
      "Bash(*id_ed25519*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(docker push*)",
      "Bash(docker image push*)",
      "Bash(docker compose push*)",
      "Bash(docker * --push*)"
    ],
    "ask": ["Bash(git push:*)", "Bash(gh pr create:*)"],
    "allow": [
      "Bash(pnpm typecheck*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm test*)",
      "Bash(pnpm build*)",
      "Bash(pnpm exec prettier*)",
      "Bash(nx run *)",
      "Bash(lerna run *)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Edit(packages/**)",
      "Bash(docker compose *)",
      "Bash(docker ps*)",
      "Bash(docker logs *)",
      "Bash(docker inspect *)",
      "Bash(docker images*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "WebFetch"
    ]
  },
  "includeCoAuthoredBy": true,
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && git diff --name-only | xargs -r pnpm exec prettier --write --ignore-unknown 2>/dev/null; exit 0"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/check-changed-packages.sh\"",
            "timeout": 300,
            "statusMessage": "Running TypeScript compilation and lint checks for changed packages..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "chrome-devtools-mcp@claude-plugins-official": true
  }
}
