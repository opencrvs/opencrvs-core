{
  "ignore": [
    "**/*.@(editorconfig|md|log|lock|patch|prettierrc|gitignore|eslintignore|stylelintrc|csv|gz|geojson|woff2|woff|xml|yarnrc|yarn-integrity|ttf|map|pdf|snap|dockerignore|jsonc|idea|env|info|key|pub|cjs|sql)",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    ".nxignore",
    "packages/testland/reqs-gathering-templates",
    "packages/countryconfig-template/pnpm-lock.yaml",
    "packages/countryconfig-template/.nvmrc",
    "packages/countryconfig-template/.tiltignore",
    "packages/countryconfig-template/Tiltfile",
    "packages/countryconfig-template/.husky",
    ".husky",
    "**/*.ipynb",
    "**/.wireit",
    ".git",
    ".github/DISCUSSION_TEMPLATE/Installation.yml",
    ".github/CODEOWNERS",
    ".github/scripts/changed-files-affect-storybook.mjs",
    "**/patches",
    ".secrets",
    "deploy_key.enc",
    "license-header.txt",
    ".vscode",
    ".history",
    "data",
    "backups",
    "**/coverage",
    "packages/client/public/robots.txt",
    "packages/client/public/mockServiceWorker.js",
    "packages/client/public/pdfjs/pdf.worker.min.mjs",
    "packages/login/public/robots.txt",
    ".env*",
    ".vs",
    "**/.DS_Store",
    "AUTHORS",
    "LICENSE",
    "Tiltfile",
    "charts",
    "license-header.txt",
    "**/*Dockerfile*",
    "**/packages/components/lib",
    "**/packages/*/build",
    "packages/client/index.html",
    "packages/login/index.html",
    "packages/components/**/*.mdx",
    "packages/components/.storybook/preview.jsx",
    "packages/components/.storybook/manager-head.html",
    "grafana",
    "packages/client/public/assets/qr-sample.webm",
    "packages/client/.storybook/preview-head.html",
    "packages/client/storybook-static",
    ".nvmrc",
    ".idea",
    "packages/client/dev-dist",
    "packages/toolkit/.npmignore",
    "packages/toolkit/tsconfig.tsbuildinfo",
    ".nx/**",
    ".swc/**",
    "**/.swc/**",
    "**/.tsc-tests/**",
    ".playwright-cli/**",
    "**/playwright-report/**",
    "**/*.webm",
    "packages/toolkit/tsconfig.build.tsbuildinfo",
    "packages/toolkit/create-countryconfig/index.js",
    "packages/toolkit/src/environment/templates/**",
    "packages/commons/src/events/EventConfig.mermaid",
    "packages/commons/src/events/EventUpdateFlow.mermaid",
    "packages/events/src/storage/postgres/events/schema/**/*.ts",
    "packages/events/.kanelrc.js",
    "packages/dashboards/data/metabase/*",
    "packages/events/src/tests/extract-dump.sh",
    ".kube",
    ".claude",
    ".nx",
    "packages/api-docs/public-key.pem",
    ".codex/config.toml",
    "packages/mosip/.npmignore",
    "packages/mosip-api/docs/example-certs",
    "packages/mosip-api/certs",
    "packages/mosip-mock/src/mock-only-private-key.pem",
    "packages/esignet-mock/src/dev-secrets",
    "packages/esignet-mock/src/mock-authorizer/index.html"
  ],
  "license": "license-header.txt",
  "licenseFormats": {
    "sh|yml|yaml|toml|conf|txt|dotfile|tilt|ps1|prettierignore": {
      "eachLine": {
        "prepend": "# "
      }
    },
    "html|xml|svg|mdx": {
      "prepend": "<!--",
      "append": "-->"
    },
    "ts|tsx|js|mjs|css": {
      "prepend": "/*",
      "append": " */",
      "eachLine": {
        "prepend": " * "
      }
    },
    "ini": {
      "eachLine": {
        "prepend": "; "
      }
    }
  },
  "trailingWhitespace": "TRIM"
}
