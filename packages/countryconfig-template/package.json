{
  "name": "@opencrvs/countryconfig-template",
  "version": "2.0.0",
  "description": "OpenCRVS country configuration template for forking new country configurations",
  "os": [
    "darwin",
    "linux"
  ],
  "engines": {
    "node": "22.x.x"
  },
  "license": "MPL-2.0",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "pnpm start",
    "test": "vitest",
    "test:compilation": "tsc --noEmit",
    "lint": "eslint -c eslint.config.js",
    "setup-analytics": "docker exec -i -e POSTGRES_HOST=localhost -e POSTGRES_PORT=5432 -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres -e ANALYTICS_POSTGRES_USER=events_analytics -e ANALYTICS_POSTGRES_PASSWORD=analytics_password -e TARGET_DB ${POSTGRES_CONTAINER:-opencrvs-deps-postgres-1} bash -s < ./assets/postgres/setup-analytics.sh",
    "db:clear:all": "bash assets/clear-all-data-dev.sh && pnpm setup-analytics",
    "start": "pnpm setup-analytics && cross-env NODE_ENV=development NODE_OPTIONS=--dns-result-order=ipv4first nodemon --watch src --exec tsx src/index.ts",
    "start:prod": "tsx src/index.ts",
    "metabase": "bash assets/metabase/run-dev.sh",
    "deploy": "bash assets/deployment/deploy.sh",
    "restore-snapshot": "bash assets/backups/restore-snapshot.sh",
    "snapshot": "bash assets/backups/backup.sh",
    "port-forward": "bash assets/port-forward.sh",
    "environment:init": "tsx assets/environments/setup-environment.ts",
    "environment:upgrade": "pnpm environment:init",
    "extract:translations": "opencrvs check-translations",
    "sort-translations": "cross-env NODE_ENV=development tsx src/sort-translations.ts"
  },
  "devDependencies": {
    "@inquirer/editor": "^1.2.13",
    "@octokit/core": "4.2.1",
    "@types/handlebars": "^4.1.0",
    "@types/hapi__inert": "5.2.1",
    "@types/inquirer": "^9.0.7",
    "@types/libsodium-wrappers": "^0.7.10",
    "@types/pg": "^8.15.5",
    "@types/prompts": "^2.4.9",
    "@types/react-intl": "^3.0.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.23.0",
    "@typescript-eslint/eslint-plugin": "8.63.0",
    "@typescript-eslint/parser": "8.63.0",
    "cypress-xpath": "^2.0.1",
    "eslint": "^9.23.0",
    "eslint-plugin-import": "^2.31.0",
    "inquirer": "^9.2.12",
    "js-yaml": "^4.1.0",
    "kleur": "^4.1.5",
    "libsodium-wrappers": "^0.7.13",
    "globals": "^16.0.0",
    "lint-staged": "^7.1.0",
    "node-ssh": "^13.2.0",
    "nodemon": "^2.0.22",
    "pino-pretty": "^11.0.0",
    "prettier": "^3.4.2",
    "react-intl": "^6.4.3",
    "vite": "^8.1.5",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@faker-js/faker": "^6.0.0-alpha.5",
    "@hapi/boom": "^9.1.1",
    "@hapi/hapi": "^20.0.1",
    "@hapi/inert": "^6.0.3",
    "@opencrvs/toolkit": "2.1.0-rc.f5ea803",
    "@types/chalk": "^2.2.0",
    "@types/csv2json": "^1.4.0",
    "@types/fhir": "^0.0.30",
    "@types/geojson": "^7946.0.4",
    "@types/hapi__boom": "^9.0.1",
    "@types/hapi__hapi": "^20.0.0",
    "@types/jwt-decode": "^2.2.1",
    "@types/lodash": "^4.14.117",
    "@types/luxon": "^3.7.1",
    "@types/node": "^18.19.1",
    "@types/node-fetch": "^2.6.2",
    "@types/nodemailer": "^6.4.14",
    "@types/stream-json": "^1.7.8",
    "@typescript/api": "npm:typescript@6.0.3",
    "app-module-path": "^2.2.0",
    "chalk": "^2.4.1",
    "cross-env": "^6.0.3",
    "csv-stringify": "^6.4.6",
    "csv2json": "^2.0.2",
    "date-fns": "^2.28.0",
    "dotenv": "^16.4.5",
    "elastic-apm-node": "^3.29.0",
    "envalid": "^8.0.0",
    "esbuild": "^0.18.9",
    "handlebars": "^4.7.9",
    "hapi-auth-jwt2": "10.4.0",
    "hapi-pino": "^9.0.0",
    "hapi-sentry": "^3.1.0",
    "joi": "^17.4.0",
    "jwt-decode": "^2.2.0",
    "kysely": "^0.28.14",
    "lodash": "^4.18.1",
    "luxon": "^3.7.1",
    "nanoid": "3",
    "node-fetch": "^2.6.1",
    "nodemailer": "^7.0.11",
    "opener": "^1.5.1",
    "pg": "^8.16.3",
    "pino": "^7.0.0",
    "pkg-up": "^3.1.0",
    "prompts": "^2.4.2",
    "short-uid": "^0.1.0",
    "stream-json": "^1.9.1",
    "tsconfig-paths": "^3.8.0",
    "tsx": "^4.15.7",
    "typescript": "7.0.2",
    "uuid": "^11.1.0",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "src/**/*.{ts,graphql}": [
      "sh -c 'pnpm extract:translations'",
      "eslint --fix",
      "prettier --write",
      "git add"
    ],
    "src/translations/*.csv": [
      "pnpm sort-translations",
      "git add"
    ]
  },
  "resolutions": {
    "acorn": "^6.4.1",
    "braces": "^3.0.3",
    "cross-spawn": "^7.0.5",
    "flatted": "^3.4.2",
    "form-data": "^4.0.4",
    "jws": "^3.2.3",
    "minimatch": "^3.1.4",
    "picomatch": "^2.3.2",
    "rollup": "^4.59.0",
    "semver": "^7.5.2",
    "handlebars": "4.7.9",
    "lodash": "4.18.1",
    "@hapi/content": ">=6.0.1",
    "@trpc/server": ">=11.8.0"
  }
}
