# Newest 22.x release was having issues with fetch()
# https://opencrvsworkspace.slack.com/archives/C07M2FETFFB/p1781856414463509
FROM node:22.22.3-slim

# Do not remove APT_CACHE_DATE. No command reads it, but its value
# changes the cache key of the commands that follow it.
# CI sets it to the current date. When the date changes, Docker does not
# use the cached upgrade layer and runs apt-get upgrade again.
# This gives two good results:
# - Each day, the image gets the new Debian security fixes.
# - Builds on the same day use the cache, so they are fast.
# Do not put KEY, SECRET or TOKEN in the name. The Docker check
# SecretsUsedInArgOrEnv then reports the arg as sensitive data.
ARG APT_CACHE_DATE

RUN apt-get update && apt-get upgrade -y && \
    apt-get clean && \
    rm -rf /var/cache/apt/archives /var/lib/apt/lists/*

# testland and mosip use npm and npx. The npm that comes with the node image
# bundles vulnerable packages (tar, pacote, sigstore and others).
# The undici that npm 11.21.1 bundles is ignored in .trivyignore.yaml.
RUN npm install -g npm@11.21.1 && \
    npm cache clean --force

# The pnpm version is pinned by the packageManager field in package.json
RUN corepack enable pnpm

# Lets pnpm replace a production node_modules with a dev install without prompting
ENV CI=true

USER node

WORKDIR /app

COPY --chown=node:node *.json .
COPY --chown=node:node .pnpmfile.cjs pnpm-lock.yaml pnpm-workspace.yaml ./
COPY --chown=node:node patches /app/patches
# postinstall runs development-environment/link-ts6-api.js
COPY --chown=node:node development-environment/link-ts6-api.js /app/development-environment/link-ts6-api.js

RUN pnpm install --prod --frozen-lockfile

COPY --chown=node:node packages/commons /app/packages/commons

WORKDIR /app/packages/commons

RUN pnpm install --frozen-lockfile
RUN pnpm build
