# Newest 22.x release was having issues with fetch()
# https://opencrvsworkspace.slack.com/archives/C07M2FETFFB/p1781856414463509
FROM node:22.22.3-slim

# CI sets this to the current date. A new value makes the build skip the
# cached upgrade layer, so that new Debian security fixes get installed.
ARG APT_UPGRADE_DATE
RUN apt-get update && apt-get upgrade -y && \
    apt-get clean && \
    rm -rf /var/cache/apt/archives /var/lib/apt/lists/*

# Services run through pnpm. The npm that comes with the node image is not used
# and only adds vulnerabilities to the image.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx

# The pnpm version is pinned by the packageManager field in package.json
RUN corepack enable pnpm

# Lets pnpm replace a production node_modules with a dev install without prompting
ENV CI=true

USER node

WORKDIR /app

COPY --chown=node:node *.json .
COPY --chown=node:node .pnpmfile.cjs pnpm-lock.yaml pnpm-workspace.yaml ./
COPY --chown=node:node patches /app/patches
# postinstall runs development-environment/link-ts6-api.js
COPY --chown=node:node development-environment/link-ts6-api.js /app/development-environment/link-ts6-api.js

RUN pnpm install --prod --frozen-lockfile

COPY --chown=node:node packages/commons /app/packages/commons

WORKDIR /app/packages/commons

RUN pnpm install --frozen-lockfile
RUN pnpm build
