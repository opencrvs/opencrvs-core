{
  "compilerOptions": {
    "module": "ES2022",
    "lib": ["ESNext"],
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "paths": {
      "@mosip/ida-auth-sdk": ["./src/ida-auth-sdk"]
    }
  },
  "include": ["src/**/*.ts", "eslint.config.mjs"]
}
