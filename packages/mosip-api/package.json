{
  "name": "@opencrvs/mosip-api",
  "version": "2.0.1",
  "license": "MPL-2.0",
  "engines": {
    "node": "22.x.x"
  },
  "scripts": {
    "start": "NODE_ENV=development tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start:prod": "NODE_ENV=production tsx src/index.ts",
    "copy-example-certs": "mkdir -p certs && cp -n docs/example-certs/* certs/ || true",
    "prestart": "pnpm copy-example-certs",
    "pretest": "pnpm copy-example-certs",
    "test": "NODE_ENV=development tsx --test",
    "test:compilation": "tsc --noEmit",
    "lint": "eslint -c eslint.config.js"
  },
  "dependencies": {
    "@opencrvs/mosip": "workspace:*",
    "@fastify/cors": "^10.1.0",
    "@fastify/formbody": "^8.0.1",
    "@fastify/jwt": "^9.0.4",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.1.0",
    "@opencrvs/toolkit": "workspace:*",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.8.2",
    "@types/node-forge": "^1.3.11",
    "better-sqlite3": "^11.9.1",
    "canonicalize": "^2.1.0",
    "date-fns": "^4.1.0",
    "envalid": "^8.0.0",
    "fastify": "^5.0.0",
    "fastify-type-provider-zod": "^5.0.0",
    "jose": "^5.9.6",
    "jsonwebtoken": "^9.0.2",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.17.21",
    "node-forge": "^1.3.1",
    "openapi-types": "^12.1.3",
    "tsx": "^4.19.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "8.63.0",
    "@typescript-eslint/parser": "8.63.0",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.5",
    "msw": "^2.7.3",
    "pino-pretty": "^11.3.0"
  }
}
