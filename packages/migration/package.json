{
  "name": "@opencrvs/migration",
  "version": "2.1.1",
  "description": "OpenCRVS migration microservice",
  "homepage": "https://github.com/opencrvs/opencrvs-core#readme",
  "type": "module",
  "license": "MPL-2.0",
  "scripts": {
    "start": "./run-migrations.sh",
    "revert": "./revert-migrations.sh",
    "rollback:events": "node-pg-migrate down --config-file node-pg-migrate.json",
    "migrate:events": "./run-migrations.sh",
    "start:prod": "NODE_ENV=production ./run-migrations.sh",
    "create:events": "node-pg-migrate create --config-file node-pg-migrate.json",
    "lint": "eslint -c eslint.config.cjs --max-warnings=0",
    "test:compilation": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "node-pg-migrate": "^8.0.3",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/pg": "^8.15.1",
    "@typescript-eslint/eslint-plugin": "8.63.0",
    "@typescript-eslint/parser": "8.63.0",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.5",
    "prettier": "3.5.3"
  },
  "lint-staged": {
    "src/**/*.js": [
      "prettier --write"
    ]
  },
  "keywords": [
    "migration",
    "nodejs"
  ]
}
