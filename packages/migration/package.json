{
  "name": "@opencrvs/migration",
  "version": "2.1.0",
  "description": "OpenCRVS migration microservice",
  "homepage": "https://github.com/opencrvs/opencrvs-core#readme",
  "type": "module",
  "license": "MPL-2.0",
  "scripts": {
    "start": "./run-migrations.sh",
    "revert": "./revert-migrations.sh",
    "rollback:events": "DATABASE_URL=postgres://events_migrator:migrator_password@localhost:5432/events node-pg-migrate down --schema=app --migrations-dir=./src/migrations/events",
    "migrate:events": "DATABASE_URL=postgres://events_migrator:migrator_password@localhost:5432/events node-pg-migrate up --schema=app --migrations-dir=./src/migrations/events",
    "start:prod": "NODE_ENV=production ./run-migrations.sh",
    "create:events": "DATABASE_URL=postgres://events_migrator:migrator_password@localhost:5432/events pnpm node-pg-migrate create --migrations-dir=./src/migrations/events --migration-file-language=sql",
    "lint": "eslint -c eslint.config.cjs --max-warnings=0",
    "test:compilation": "tsc --noEmit",
    "test": "pnpm test:compilation"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "node-pg-migrate": "^8.0.3",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/pg": "^8.15.1",
    "@typescript-eslint/eslint-plugin": "8.63.0",
    "@typescript-eslint/parser": "8.63.0",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.5",
    "prettier": "3.5.3"
  },
  "lint-staged": {
    "src/**/*.js": [
      "prettier --write"
    ]
  },
  "keywords": [
    "migration",
    "nodejs"
  ]
}
