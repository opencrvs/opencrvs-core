{
  "name": "@opencrvs/data-seeder",
  "version": "2.1.0",
  "description": "OpenCRVS data-seeder microservice",
  "homepage": "https://github.com/opencrvs/opencrvs-core#readme",
  "license": "MPL-2.0",
  "scripts": {
    "seed": "NODE_OPTIONS=--dns-result-order=ipv4first tsx src/index.ts",
    "test:compilation": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint -c eslint.config.js --fix --max-warnings=0"
  },
  "devDependencies": {
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.5",
    "prettier": "3.5.3",
    "tsx": "^4.15.7",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@opencrvs/commons": "workspace:*",
    "superjson": "1.9.0-0",
    "@opencrvs/events": "workspace:*",
    "@trpc/client": "11.4.3",
    "@types/node": "^16.18.39",
    "@types/node-fetch": "^2.5.12",
    "envalid": "^8.0.0",
    "jwt-decode": "^3.0.0",
    "node-fetch": "^2.6.1",
    "uuid": "^3.3.2",
    "zod": "^4.4.3",
    "zod-validation-error": "^5.0.0"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "keywords": [
    "data-seeder",
    "nodejs"
  ]
}
