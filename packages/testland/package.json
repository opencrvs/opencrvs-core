{
  "name": "@opencrvs/testland",
  "version": "2.0.0",
  "description": "OpenCRVS country configuration for reference data",
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "engines": {
    "node": "22.x.x"
  },
  "license": "MPL-2.0",
  "scripts": {
    "dev": "pnpm start",
    "e2e-win": "pnpm playwright test --ui",
    "e2e": "NODE_OPTIONS=--dns-result-order=ipv4first pnpm playwright test --ui",
    "e2e-dev": "NODE_ENV=development NODE_OPTIONS=--dns-result-order=ipv4first pnpm playwright test --ui",
    "precommit": "lint-staged",
    "test": "vitest run --exclude e2e --silent --passWithNoTests",
    "test:watch": "vitest",
    "test:compilation": "tsc --noEmit --resolveJsonModule",
    "lint": "eslint -c eslint.config.js",
    "setup-analytics": "docker exec -i -e POSTGRES_HOST=localhost -e POSTGRES_PORT=5432 -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres -e ANALYTICS_POSTGRES_USER=events_analytics -e ANALYTICS_POSTGRES_PASSWORD=analytics_password -e TARGET_DB ${POSTGRES_CONTAINER:-opencrvs-deps-postgres-1} bash -s < ./assets/postgres/setup-analytics.sh",
    "setup-reference-data": "docker exec -i -e POSTGRES_HOST=localhost -e POSTGRES_PORT=5432 -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres -e REFERENCE_DATA_POSTGRES_USER=events_reference_data -e REFERENCE_DATA_POSTGRES_PASSWORD=reference_data_password -e REFERENCE_DATA_EDITOR_USER=reference_data_editor_user -e REFERENCE_DATA_EDITOR_PASSWORD=reference_data_editor_password -e TARGET_DB ${POSTGRES_CONTAINER:-opencrvs-deps-postgres-1} bash -s < ./assets/postgres/setup-reference-data.sh",
    "db:clear:all": "pnpm -w run db:clear:all",
    "start": "pnpm setup-analytics && pnpm setup-reference-data &&  cross-env NODE_ENV=development NODE_OPTIONS=--dns-result-order=ipv4first nodemon --watch src --exec tsx src/index.ts",
    "start:prod": "tsx src/index.ts",
    "metabase": "bash assets/metabase/run-dev.sh",
    "extract:translations": "tsx ../toolkit/src/cli.ts check-translations",
    "sort-translations": "cross-env NODE_ENV=development tsx src/sort-translations.ts"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@inquirer/editor": "^1.2.13",
    "@octokit/core": "4.2.4",
    "@playwright/test": "^1.48.0",
    "@types/google-libphonenumber": "^7.4.23",
    "@types/handlebars": "^4.1.0",
    "@types/hapi__h2o2": "8.3.3",
    "@types/inquirer": "^9.0.7",
    "@types/libsodium-wrappers": "^0.7.10",
    "@types/pg": "^8.15.5",
    "@types/prompts": "^2.4.9",
    "@types/react-intl": "^3.0.0",
    "@typescript-eslint/eslint-plugin": "8.63.0",
    "@typescript-eslint/parser": "8.63.0",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.5",
    "globals": "^16.0.0",
    "inquirer": "^9.2.12",
    "js-yaml": "^4.1.0",
    "kleur": "^4.1.5",
    "libsodium-wrappers": "^0.7.13",
    "lint-staged": "^15.2.10",
    "node-ssh": "^13.2.0",
    "nodemon": "^2.0.22",
    "pino-pretty": "^11.0.0",
    "playwright-ctrf-json-reporter": "^0.0.18",
    "prettier": "3.5.3",
    "react-intl": "^6.4.3",
    "vite": "^8.1.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@opencrvs/mosip": "workspace:*",
    "@faker-js/faker": "^9.3.0",
    "@hapi/boom": "^9.1.1",
    "@hapi/h2o2": "^9.1.0",
    "@hapi/hapi": "21.4.8",
    "@hapi/inert": "^7.0.0",
    "@opencrvs/toolkit": "workspace:*",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.220.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-metrics": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@types/chalk": "^2.2.0",
    "@types/code": "^4.0.3",
    "@types/csv2json": "^1.4.0",
    "@types/fhir": "0.0.30",
    "@types/geojson": "^7946.0.4",
    "@types/jest": "^24.0.13",
    "@types/jwt-decode": "^2.2.1",
    "@types/lodash": "^4.14.117",
    "@types/luxon": "^3.7.1",
    "@types/node": "^20.12.7",
    "@types/node-fetch": "^2.6.2",
    "@types/nodemailer": "^6.4.14",
    "@types/qrcode": "^1.5.6",
    "@types/stream-json": "^1.7.8",
    "@types/uuid": "^10.0.0",
    "app-module-path": "^2.2.0",
    "chalk": "^2.4.1",
    "country-data": "^0.0.31",
    "cross-env": "^6.0.3",
    "csv-stringify": "^6.4.6",
    "csv2json": "^1.4.2",
    "date-fns": "^2.28.0",
    "dotenv": "^16.4.5",
    "envalid": "^8.0.0",
    "esbuild": "^0.18.9",
    "google-libphonenumber": "^3.2.32",
    "handlebars": "^4.7.9",
    "hapi-auth-jwt2": "10.4.0",
    "hapi-pino": "^9.0.0",
    "hapi-sentry": "^3.1.0",
    "joi": "^17.4.0",
    "jwt-decode": "^2.2.0",
    "kysely": "^0.28.14",
    "lodash": "^4.18.1",
    "luxon": "^3.7.1",
    "nanoid": "3",
    "node-fetch": "^2.6.1",
    "nodemailer": "^7.0.11",
    "opener": "^1.5.1",
    "p-queue": "^6.6.2",
    "pg": "^8.16.3",
    "pino": "^7.0.0",
    "pkg-up": "^3.1.0",
    "prompts": "^2.4.2",
    "qrcode": "^1.5.4",
    "regex-to-strings": "^2.1.0",
    "short-uid": "^0.1.0",
    "stream-json": "^1.9.1",
    "tsx": "^4.15.7",
    "uuid": "^11.1.0",
    "whatwg-fetch": "^3.0.0",
    "yargs": "^17.7.2",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "src/**/*.{ts,graphql}": [
      "sh -c 'pnpm extract:translations'"
    ],
    "{src,e2e}/**/*.{ts,graphql}": [
      "eslint --fix",
      "prettier --write",
      "git add"
    ],
    "src/translations/*.csv": [
      "pnpm sort-translations",
      "git add"
    ]
  }
}
