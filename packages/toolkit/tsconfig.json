{
  "compilerOptions": {
    "lib": ["esnext"],
    "target": "es2016",
    "module": "node16",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "./src",
    "outDir": "dist",
    // The configurator's server imports its sibling files with their .ts extension, as the browser build wants.
    "rewriteRelativeImportExtensions": true,
    "paths": {
      "@opencrvs/commons/conditionals": [
        "../commons/src/conditionals/conditionals.ts"
      ],
      "@opencrvs/commons/scopes": ["../commons/src/users/scopes.ts"],
      "@opencrvs/commons/users/Role": ["../commons/src/users/Role.ts"],
      "@opencrvs/commons/authentication": [
        "../commons/src/users/authentication.ts"
      ],
      "@opencrvs/commons/events": ["../commons/src/events/index.ts"],
      "@opencrvs/commons/events/deduplication": [
        "../commons/src/events/deduplication.ts"
      ],
      "@opencrvs/commons/notification": [
        "../commons/src/notification/index.ts"
      ],
      "@opencrvs/commons/application-config": [
        "../commons/src/application-config.ts"
      ]
    }
  },
  "references": [{ "path": "../commons/tsconfig-commonjs.json" }],
  "include": ["src/**/*.ts"],
  "exclude": [
    "**/node_modules/**",
    "dist",
    "src/configurator/ui",
    "src/configurator/tests",
    "src/configurator/scripts",
    "src/configurator/server/fakeGitHub.ts",
    "src/configurator/vite.config.ts",
    "src/configurator/yamlForms.ts"
  ]
}
