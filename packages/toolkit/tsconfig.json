{
  "compilerOptions": {
    "lib": ["esnext", "DOM"],
    "target": "es2016",
    "module": "node16",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    // Workspace packages resolve to their source, so neither has to be built.
    "paths": {
      "@events/*": ["../events/src/*"],
      "@opencrvs/events/router": ["../events/src/router/index.ts"],
      "@opencrvs/commons": ["../commons/src/index.ts"],
      "@opencrvs/commons/*": ["../commons/src/*"],
      "@opencrvs/commons/conditionals": [
        "../commons/src/conditionals/conditionals.ts"
      ],
      "@opencrvs/commons/scopes": ["../commons/src/scopes.ts"],
      "@opencrvs/commons/authentication": ["../commons/src/authentication.ts"],
      "@opencrvs/commons/events": ["../commons/src/events/index.ts"],
      "@opencrvs/commons/events/deduplication": [
        "../commons/src/events/deduplication.ts"
      ],
      "@opencrvs/commons/scopes.deprecated.do-not-use": [
        "../commons/src/scopes.deprecated.do-not-use.ts"
      ],
      "@opencrvs/commons/notification": [
        "../commons/src/notification/index.ts"
      ],
      "@opencrvs/commons/application-config": [
        "../commons/src/application-config.ts"
      ]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/node_modules/**", "dist"]
}
