{
  "name": "@opencrvs/components",
  "main": "lib/index",
  "version": "2.1.0",
  "description": "OpenCRVS UI Component library",
  "license": "MPL-2.0",
  "private": true,
  "dependencies": {
    "csstype": "^3.1.3",
    "lodash": "^4.18.1",
    "phosphor-react": "^1.4.1",
    "postinstall-postinstall": "^2.0.0",
    "qr-scanner": "^1.4.2",
    "rc-progress": "^3.5.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.53.2",
    "react-select": "3.2.0",
    "react-stickynode": "^2.1.1",
    "react-tooltip": "^4.2.21",
    "recharts": "^2.5.0",
    "styled-components": "^5.2.0",
    "vite": "^8.1.5",
    "webfontloader": "^1.6.28"
  },
  "scripts": {
    "clean": "rimraf lib",
    "start": "tsc -w --preserveWatchOutput",
    "build": "pnpm clean && tsc",
    "lint": "pnpm lint:css",
    "test": "tsc",
    "lint:css": "stylelint 'src/**/*.{ts,tsx}'",
    "build:clean": "rm -rf lib",
    "storybook": "storybook dev -p ${STORYBOOK_PORT:-6060}",
    "build-storybook": "NODE_OPTIONS=--max_old_space_size=6144 storybook build -o build --disable-telemetry",
    "recreate-src-index-ts": "bash recreate-src-index-ts.sh"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix",
      "stylelint"
    ],
    "src/**/*.json": "prettier --write"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.3",
    "@storybook/addon-docs": "^10.5.3",
    "@storybook/addon-links": "^10.5.3",
    "@storybook/react": "^10.5.3",
    "@storybook/react-vite": "^10.5.3",
    "@types/lodash": "^4.14.126",
    "@types/node": "^20.12.7",
    "@types/rc-progress": "^2.4.3",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.0",
    "@types/react-select": "^2.0.2",
    "@types/react-stickynode": "^1.4.0",
    "@types/react-tooltip": "^4.2.4",
    "@types/recharts": "^1.8.26",
    "@types/styled-components": "^5.1.3",
    "@types/webfontloader": "^1.6.34",
    "concurrently": "^8.0.0",
    "dotenv": "^6.1.0",
    "eslint-plugin-jsx-a11y": "^6.6.1",
    "eslint-plugin-styled-components-a11y": "^2.0.0",
    "prettier": "2.8.8",
    "rimraf": "^5.0.0",
    "storybook": "^10.5.3",
    "stylelint": "^14.11.0",
    "stylelint-config-recommended": "^9.0.0",
    "stylelint-config-styled-components": "^0.1.1",
    "stylelint-processor-styled-components": "^1.10.0",
    "ts-dedent": "^2.2.0",
    "eslint-plugin-storybook": "10.5.3"
  },
  "eslintConfig": {
    "extends": "react-app",
    "overrides": [
      {
        "files": [
          "**/*.stories.*"
        ],
        "rules": {
          "import/no-anonymous-default-export": "off"
        }
      }
    ]
  }
}
