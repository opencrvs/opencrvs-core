{
  "compilerOptions": {
    "module": "ESNext",
    "target": "es6",
    "lib": ["es6", "dom", "es2019"],
    "noEmit": true,
    "allowJs": false,
    "jsx": "react",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.tsx", "src/**/*.ts", ".storybook"],
  // Stories excluded: they still use the pre-Storybook-10 ComponentMeta /
  // ComponentStory API, which no longer exists. Migrating them is separate work.
  "exclude": ["node_modules", "src/**/*.stories.tsx"]
}
