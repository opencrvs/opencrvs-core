{
  "name": "@opencrvs/commons",
  "version": "2.1.0",
  "description": "OpenCRVS common modules and utils",
  "license": "MPL-2.0",
  "main": "./build/dist/common/index.js",
  "exports": {
    ".": "./build/dist/common/index.js",
    "./monitoring": "./build/dist/common/monitoring.js",
    "./types": "./build/dist/common/types.js",
    "./logger": "./build/dist/common/logger.js",
    "./authentication": "./build/dist/common/authentication.js",
    "./http": "./build/dist/common/http.js",
    "./fixtures": "./build/dist/common/fixtures.js",
    "./assignment": "./build/dist/common/assignment.js",
    "./client": "./build/dist/esm/client.js",
    "./application-config": "./build/dist/common/application-config.js",
    "./events": "./build/dist/common/events/index.js",
    "./events/deduplication": "./build/dist/common/events/deduplication.js"
  },
  "scripts": {
    "start": "pnpm build:watch",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:compilation": "tsc -b --pretty",
    "lint": "eslint -c eslint.config.js --fix --max-warnings=0",
    "build": "rm -rf build && tsc -b tsconfig.build.json --pretty",
    "build:watch": "tsc -b tsconfig.build.json --pretty --watch",
    "build:clean": "rm -rf build .tsc-tests"
  },
  "private": true,
  "dependencies": {
    "@hapi/hapi": "^21.0.0",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.9.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.220.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-metrics": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@types/jest": "^26.0.14",
    "@types/jwt-decode": "^2.2.1",
    "@types/lodash": "4.17.0",
    "@types/node-fetch": "^2.5.12",
    "@types/uuid": "^9.0.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "concurrently": "^9.1.0",
    "date-fns": "^2.28.0",
    "jest": "29.7.0",
    "jwt-decode": "^3.0.0",
    "lodash": "^4.18.1",
    "node-fetch": "^2.6.7",
    "object-hash": "^3.0.0",
    "pino": "^7.0.0",
    "pkg-up": "^3.1.0",
    "qs": "6.15.2",
    "uuid": "^9.0.0",
    "yaml": "^2.7.1",
    "zod": "^4.4.3",
    "zod-openapi": "^5.4.6"
  },
  "devDependencies": {
    "@swc-contrib/mut-cjs-exports": "^14.15.0",
    "@swc/core": "^1.15.43",
    "@swc/jest": "^0.2.39",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/object-hash": "^3.0.6",
    "@types/qs": "^6.14.0",
    "@typescript-eslint/eslint-plugin": "8.63.0",
    "@typescript-eslint/parser": "8.63.0",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-import-resolver-typescript": "^4.3.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.5",
    "jest-fetch-mock": "^2.1.2",
    "jsonwebtoken": "^9.0.2",
    "pino-pretty": "^11.0.0",
    "tsx": "^4.15.7"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "jest": {
    "transform": {
      "^.+\\.tsx?$": [
        "@swc/jest",
        {
          "jsc": {
            "experimental": {
              "plugins": [
                [
                  "@swc-contrib/mut-cjs-exports",
                  {}
                ]
              ]
            }
          }
        }
      ]
    },
    "coverageReporters": [
      "json",
      "lcov",
      "text",
      "html",
      "json-summary"
    ],
    "testRegex": "(/__tests__/.*|(\\.|/)(test|spec))\\.tsx?$",
    "setupFiles": [
      "./test/setupJest.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "testEnvironment": "node"
  }
}
