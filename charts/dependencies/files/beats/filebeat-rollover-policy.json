{
  "policy": {
    "phases": {
      "hot": {
        "min_age": "0ms",
        "actions": {
          "rollover": {
            "max_age": "1d",
            "max_size": "200mb"
          }
        }
      },
      "delete": {
        "min_age": "{{ .Values.monitoring.logs.retention_days }}d",
        "actions": {
          "delete": {
            "delete_searchable_snapshot": true
          }
        }
      }
    },
    "_meta": {
      "managed": true,
      "description": "built-in ILM policy using the hot and warm phases with a retention of {{ .Values.monitoring.logs.retention_days }} days"
    }
  }
}
